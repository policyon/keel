{
  "name": "a-redirect-on-grep-still-needs-a-plan",
  "direction": "block",
  "description": "A read-only command word with a redirect writes: grep clears the word test and the redirect lands on a real file, so the allowlist does not clear the segment.",
  "files": [
    {
      "path": ".keel/keel-policy.md",
      "text": "---\ntier: 2\n---\n\n# keel policy - fixture project\n"
    }
  ],
  "env": {},
  "stdin": {
    "session_id": "$SESSION",
    "cwd": "$PROJECT",
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
      "command": "grep -rn workshop . > out.txt"
    }
  },
  "expect_exit": 2,
  "expect_stdout_contains": [
    "PLAN GATE",
    "\"permissionDecision\": \"deny\"",
    "keel-plan-$SESS8.md"
  ],
  "expect_stderr_contains": [
    "PLAN GATE"
  ]
}
