{
  "name": "a-blocked-command-is-logged-by-its-redacted-head",
  "direction": "block",
  "description": "The middle path, through the shipped launcher: the audit line names the command that was refused instead of the opaque mask.",
  "files": [
    {
      "path": ".keel/keel-policy.md",
      "text": "---\ntier: 2\n---\n\n# keel policy - fixture project\n"
    }
  ],
  "env": {},
  "stdin": {
    "session_id": "$SESSION",
    "cwd": "$PROJECT",
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
      "command": "rm -rf build/cache"
    }
  },
  "expect_exit": 2,
  "expect_stdout_contains": [
    "\"permissionDecision\": \"deny\""
  ],
  "expect_stderr_contains": [],
  "expect_audit_events": ["gate_block"],
  "expect_audit_contains": ["\"target\": \"rm -rf build/cache\""]
}
