{
  "name": "policy-lock-denies-powershell-env-tamper",
  "direction": "block",
  "description": "Kill switches are the user's; an agent may not set them for itself.",
  "files": [
    {
      "path": ".keel/keel-policy.md",
      "text": "---\ntier: 2\n---\n\n# keel policy - fixture project\n"
    },
    {
      "path": ".keel/plans/keel-plan-$SESS8.md",
      "text": "# Plan\n\n- [ ] T1: the thing | AC: it works\n"
    }
  ],
  "env": {},
  "stdin": {
    "session_id": "$SESSION",
    "cwd": "$PROJECT",
    "hook_event_name": "PreToolUse",
    "tool_name": "PowerShell",
    "tool_input": {
      "command": "$env:KEEL_OVERRIDE = \"on\""
    }
  },
  "expect_exit": 2,
  "expect_stdout_contains": [
    "POLICY LOCK",
    "\"permissionDecision\": \"deny\""
  ],
  "expect_stderr_contains": []
}
