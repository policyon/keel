{
  "name": "policy-lock-denies-cd-into-hooks-then-rm",
  "direction": "block",
  "description": "Segment scoping is not an escape hatch: cd into a protected directory taints what follows.",
  "files": [
    {
      "path": ".keel/keel-policy.md",
      "text": "---\ntier: 2\n---\n\n# keel policy - fixture project\n"
    },
    {
      "path": ".keel/plans/keel-plan-$SESS8.md",
      "text": "# Plan\n\n- [ ] T1: the thing | AC: it works\n"
    }
  ],
  "env": {},
  "stdin": {
    "session_id": "$SESSION",
    "cwd": "$PROJECT",
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
      "command": "cd hooks && rm *.py"
    }
  },
  "expect_exit": 2,
  "expect_stdout_contains": [
    "POLICY LOCK",
    "\"permissionDecision\": \"deny\""
  ],
  "expect_stderr_contains": []
}
