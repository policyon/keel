{
  "name": "policy-lock-denies-uppercase-policy-edit",
  "direction": "block",
  "description": "Case variant of the same target (R1): the lock is casefolded, and both cases ship.",
  "files": [
    {
      "path": ".keel/keel-policy.md",
      "text": "---\ntier: 2\n---\n\n# keel policy - fixture project\n"
    },
    {
      "path": ".keel/plans/keel-plan-$SESS8.md",
      "text": "# Plan\n\n- [ ] T1: the thing | AC: it works\n"
    }
  ],
  "env": {},
  "stdin": {
    "session_id": "$SESSION",
    "cwd": "$PROJECT",
    "hook_event_name": "PreToolUse",
    "tool_name": "Edit",
    "tool_input": {
      "file_path": ".KEEL/KEEL-POLICY.MD"
    }
  },
  "expect_exit": 2,
  "expect_stdout_contains": [
    "POLICY LOCK",
    "\"permissionDecision\": \"deny\""
  ],
  "expect_stderr_contains": []
}
