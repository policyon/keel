{
  "name": "a-mutating-command-still-needs-a-plan",
  "direction": "block",
  "description": "The other direction of the same scoping: a mutating verb with no ledger for this session is still refused, and the refusal still names the file to write.",
  "files": [
    {
      "path": ".keel/keel-policy.md",
      "text": "---\ntier: 2\n---\n\n# keel policy - fixture project\n"
    }
  ],
  "env": {},
  "stdin": {
    "session_id": "$SESSION",
    "cwd": "$PROJECT",
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
      "command": "rm -rf build && mv dist out"
    }
  },
  "expect_exit": 2,
  "expect_stdout_contains": [
    "PLAN GATE",
    "\"permissionDecision\": \"deny\"",
    "keel-plan-$SESS8.md"
  ],
  "expect_stderr_contains": [
    "PLAN GATE"
  ]
}
