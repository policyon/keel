{
  "name": "an-overridden-command-bypass-names-the-command",
  "direction": "allow",
  "description": "A policy-lock refusal the override suspended is still accountable backward, and now the bypass line says what was run.",
  "files": [
    {
      "path": ".keel/keel-policy.md",
      "text": "---\ntier: 2\n---\n\n# keel policy - fixture project\n"
    },
    {
      "path": ".keel/plans/keel-plan-$SESS8.md",
      "text": "# Plan\n\n- [ ] T1: the thing | AC: it works\n"
    }
  ],
  "env": {
    "KEEL_OVERRIDE": "on"
  },
  "stdin": {
    "session_id": "$SESSION",
    "cwd": "$PROJECT",
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
      "command": "Set-Content hooks/keel_gate.py 'x'"
    }
  },
  "expect_exit": 0,
  "expect_stdout_contains": [],
  "expect_stderr_contains": [],
  "expect_audit_events": ["gate_bypass"],
  "expect_audit_contains": ["\"target\": \"Set-Content hooks/keel_gate.py 'x'\", \"switch\": \"KEEL_OVERRIDE\""]
}
