{
  "name": "a-sed-in-place-still-needs-a-plan",
  "direction": "block",
  "description": "The other direction of the same word: -i edits the file in place, which the print-only test refuses to clear, so with no ledger on file this still requires a plan.",
  "files": [
    {
      "path": ".keel/keel-policy.md",
      "text": "---\ntier: 2\n---\n\n# keel policy - fixture project\n"
    }
  ],
  "env": {},
  "stdin": {
    "session_id": "$SESSION",
    "cwd": "$PROJECT",
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
      "command": "sed -i 's/tier: 2/tier: 3/' notes.md"
    }
  },
  "expect_exit": 2,
  "expect_stdout_contains": [
    "PLAN GATE",
    "\"permissionDecision\": \"deny\"",
    "keel-plan-$SESS8.md"
  ],
  "expect_stderr_contains": [
    "PLAN GATE"
  ]
}
