{
  "name": "a-mutation-chained-after-a-read-still-needs-a-plan",
  "direction": "block",
  "description": "Chaining is judged per segment and every segment must pass: diff clears the allowlist, rm never will, so the command as a whole does not.",
  "files": [
    {
      "path": ".keel/keel-policy.md",
      "text": "---\ntier: 2\n---\n\n# keel policy - fixture project\n"
    }
  ],
  "env": {},
  "stdin": {
    "session_id": "$SESSION",
    "cwd": "$PROJECT",
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
      "command": "diff a.md b.md; rm a.md"
    }
  },
  "expect_exit": 2,
  "expect_stdout_contains": [
    "PLAN GATE",
    "\"permissionDecision\": \"deny\"",
    "keel-plan-$SESS8.md"
  ],
  "expect_stderr_contains": [
    "PLAN GATE"
  ]
}
