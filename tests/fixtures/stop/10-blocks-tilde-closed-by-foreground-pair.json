{
  "name": "blocks-tilde-closed-by-foreground-pair",
  "direction": "block",
  "description": "A handoff_end well after its start is a genuine close, so the [~] is stale.",
  "files": [
    {
      "path": ".keel/keel-policy.md",
      "text": "---\ntier: 2\n---\n\n# keel policy - fixture project\n"
    },
    {
      "path": ".keel/plans/keel-plan-$SESS8.md",
      "text": "# Plan\n\n- [~] T1: delegated to executor | AC: it works\n"
    },
    {
      "path": ".keel/audit/keel-audit.jsonl",
      "text": "{\"v\": 1, \"ts\": \"$TS(-70)\", \"event\": \"handoff_start\", \"session\": \"$SESSION\", \"tool_use_id\": \"tu_fg_1\", \"subagent_type\": \"executor\", \"description\": \"T1\"}\n{\"v\": 1, \"ts\": \"$TS(-5)\", \"event\": \"handoff_end\", \"session\": \"$SESSION\", \"tool_use_id\": \"tu_fg_1\", \"subagent_type\": \"executor\", \"description\": \"T1\"}\n"
    }
  ],
  "env": {},
  "stdin": {
    "session_id": "$SESSION",
    "cwd": "$PROJECT",
    "hook_event_name": "Stop"
  },
  "expect_exit": 2,
  "expect_stdout_contains": [
    "STOP BLOCKED",
    "no active delegation"
  ],
  "expect_stderr_contains": []
}
