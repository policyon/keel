{
  "name": "blocks-open-ledger",
  "direction": "block",
  "description": "An unaccounted-for [ ] item blocks the turn from ending.",
  "files": [
    {
      "path": ".keel/keel-policy.md",
      "text": "---\ntier: 2\n---\n\n# keel policy - fixture project\n"
    },
    {
      "path": ".keel/plans/keel-plan-$SESS8.md",
      "text": "# Plan\n\n- [ ] T1: the thing | AC: it works\n"
    }
  ],
  "env": {},
  "stdin": {
    "session_id": "$SESSION",
    "cwd": "$PROJECT",
    "hook_event_name": "Stop"
  },
  "expect_exit": 2,
  "expect_stdout_contains": [
    "STOP BLOCKED",
    "\"permissionDecision\": \"deny\"",
    "\"hookEventName\": \"Stop\"",
    "keel-plan-$SESS8.md"
  ],
  "expect_stderr_contains": [
    "STOP BLOCKED"
  ]
}
